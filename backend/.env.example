PORT=3000
NODE_ENV=development

# Database (Supabase PostgreSQL or Local PostgreSQL)
# For Supabase: Transaction pooler (Port 6543)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitness_db?schema=public"
# For Supabase: Direct connection for migrations (Port 5432)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fitness_db?schema=public"

# Supabase Auth & Storage
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-min-32-characters"

# JWT Fallback (for standalone token verification / signing)
JWT_SECRET="fitness-platform-super-secret-jwt-key-2026"
JWT_EXPIRES_IN="7d"

# AI Service Providers (OpenAI & Gemini)
OPENAI_API_KEY="your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"
DEFAULT_AI_PROVIDER="openai"

# Redis & Cache (Optional / BullMQ)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
