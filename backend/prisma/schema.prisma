  amountMl  Int      @map("amount_ml")
  loggedAt  DateTime @default(now()) @map("logged_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, date])
  @@map("water_logs")
}

model WeightLog {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  date               DateTime @db.Date
  weightKg           Float    @map("weight_kg")
  bodyFatPercentage  Float?   @map("body_fat_percentage")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, date])
  @@map("weight_logs")
}

model BodyMeasurement {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  chestCm   Float?   @map("chest_cm")
  waistCm   Float?   @map("waist_cm")
  hipsCm    Float?   @map("hips_cm")
  bicepsCm  Float?   @map("biceps_cm")
  thighsCm  Float?   @map("thighs_cm")
  calvesCm  Float?   @map("calves_cm")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, date])
  @@map("body_measurements")
}

model ProgressPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  photoUrl  String   @map("photo_url")
  pose      String?  @default("Front")
  date      DateTime @db.Date
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, date])
  @@map("progress_photos")
}

// ----------------------------------------------------
// AI CONVERSATIONS & COACH
// ----------------------------------------------------

model AiConversation {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  title     String      @default("Fitness Coach Session")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([tenantId, userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  role           AiMessageRole @default(USER)
  content        String
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

// ----------------------------------------------------
// SUBSCRIPTIONS & AUDIT LOGS
// ----------------------------------------------------

model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  planTier          SubscriptionTier   @default(FREE) @map("plan_tier")
  status            SubscriptionStatus @default(ACTIVE)
  maxCustomers      Int                @default(10) @map("max_customers")
  maxTrainers       Int                @default(2) @map("max_trainers")
  maxNutritionists  Int                @default(1) @map("max_nutritionists")
  aiFeaturesEnabled Boolean            @default(true) @map("ai_features_enabled")
  startsAt          DateTime           @default(now()) @map("starts_at") @db.Timestamptz(6)
  expiresAt         DateTime?          @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("subscriptions")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?   @relation(fields: [actorId], references: [id])

  @@index([tenantId])
  @@index([actorId])
  @@index([resourceType])
  @@map("audit_logs")
}
